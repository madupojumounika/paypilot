# API server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000

# Required for persistent accounts and API data
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Free AI shopping research (no paid plan required; free-tier limits apply)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
TAVILY_API_KEY=

# PayPal Sandbox checkout. Keep the secret on the API server only; never commit real credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
VITE_PAYPAL_CLIENT_ID=

# Google Identity Services OAuth 2.0 Web client ID (same ID in frontend and backend)
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
